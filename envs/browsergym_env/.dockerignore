# Ignore Python cache and build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/
.env
.venv
venv/
.envrc

# Ignore test and notebook files
*.ipynb
tests/

# Ignore git and editor files
.git/
.gitignore
*.swp
*.swo
.DS_Store

# Ignore docs and markdown not needed in image
docs/
README.md
*.md

# Ignore local config and OS files
*.log
*.tmp
*.bak
Thumbs.db
